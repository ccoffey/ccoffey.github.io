{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Portfolio Site",
      "type": "shell",
      "command": "python3 scripts/build_site.py --output _site",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": false
      },
      "problemMatcher": []
    },
    {
      "label": "Start Dev Server (Watch & Serve)",
      "type": "shell",
      "command": "python3 dev_server.py",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    }
  ]
}
